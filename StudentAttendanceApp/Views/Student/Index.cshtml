@model List<StudentAttendanceApp.Models.Student>

<h2>All Students</h2>

<a href="/Student/Create">Add New Student</a>
<br /><br />

<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Registration No</th>
        <th>Department</th>
        <th>Attendance %</th>
        <th>Actions</th>
    </tr>
    @foreach (var s in Model)
    {
        <tr>
            <td>@s.StudentId</td>
            <td>@s.StudentName</td>
            <td>@s.RegistrationNumber</td>
            <td>@s.Department</td>
            <td>@s.AttendancePercentage</td>
            <td>
                <a href="/Student/Edit/@s.StudentId">Edit</a> | 
                <a href="/Student/Delete/@s.StudentId">Delete</a>
            </td>
        </tr>
    }
</table>
